# Backend Environment Variables Example
# Copy to .env or export into your environment for production/local runtime

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=library_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Security (Must be at least 256-bit secret key)
JWT_SECRET=your_secure_256_bit_secret_key_here_minimum_32_characters
JWT_EXPIRATION_MS=86400000

# OTP Settings
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Mail Configuration (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
APP_MAIL_DEV_MODE=false
APP_MAIL_FROM=noreply@yourdomain.com

# Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
